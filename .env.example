# ─── App config (baked into the bundle at build time) ──────────────────────

# Centralized claims service (ar-io-claims) base URL. REQUIRED — every
# lookup/claim goes through this API. Point it at your deployment (local dev
# default shown). The claim/lookup pages surface a banner if it is unset or
# unreachable.
VITE_CLAIMS_API_URL=http://localhost:3040

# Network the canonical-message preview + health banner expect. Otherwise
# inferred from VITE_SOLANA_RPC_URL. solana-mainnet | solana-devnet.
# VITE_ESCROW_NETWORK=solana-mainnet

# Solana RPC endpoint. Only used to infer the network label and to construct
# a (lazy, unused) kit RPC client for signature-compatible service calls — the
# app no longer reads escrow state from Solana. Defaults to mainnet-beta.
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Deposits are disabled: the centralized ledger is authority-funded, there are
# no user deposits. Leave false (deposit UI is hidden entirely when off).
VITE_DEPOSITS_ENABLED=false

# Optional: pin the ARIO SPL mint used for display-only formatting on custom
# clusters. Otherwise inferred from VITE_SOLANA_RPC_URL.
# VITE_ARIO_MINT=<spl mint address>

# NOTE: the pre-pivot on-chain variables (VITE_ESCROW_PROGRAM_ID,
# VITE_ATTESTOR_URL) are no longer required. The app now talks only to
# VITE_CLAIMS_API_URL. VITE_ESCROW_PROGRAM_ID still overrides the (dormant)
# program id used by the vestigial, disabled deposit/manage flows.

# ─── Deploy (yarn deploy → permaweb-deploy) ────────────────────────────────

# ArNS name to assign the deployed manifest to (you must own it on AR.IO).
VITE_ARNS_NAME=my-escrow-app

# Arweave deploy wallet, base64-encoded JWK. Set at deploy time only — never
# commit it. Generate with:  export DEPLOY_KEY=$(base64 -i wallet.json)
# (Alternatively pass --wallet ./wallet.json or --private-key to permaweb-deploy.)
# DEPLOY_KEY=
